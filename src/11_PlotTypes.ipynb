   "source": [
    "# errorbars\n",
    "x = np.arange(0, 4, 0.2) \n",
    "y = np.exp(-x) \n",
    "dy = 0.1 * np.abs(np.random.randn(len(y))) \n",
    "dx = 0.1 * np.abs(np.random.randn(len(y))) \n",
    "plt.errorbar(x,y,xerr=dx,yerr=dy,marker='o',markersize=8.0,capsize=0.0,elinewidth=1.0)"
   ]
  },
